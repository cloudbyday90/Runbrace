{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runbrace:schema:condition:1",
  "title": "Runbrace draft consumer condition v1",
  "description": "Reported condition normalized for external workflows; no remediation decision or verified outcome.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "source",
    "entity",
    "condition",
    "observed_at",
    "received_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "$ref": "urn:runbrace:schema:identity:1#/$defs/owned_id"
    },
    "source": {
      "$ref": "urn:runbrace:schema:identity:1#/$defs/source"
    },
    "source_event_id": {
      "$ref": "urn:runbrace:schema:identity:1#/$defs/opaque_id"
    },
    "entity": {
      "$ref": "urn:runbrace:schema:identity:1#/$defs/entity"
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "state",
        "severity",
        "message"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        },
        "state": {
          "enum": [
            "failing",
            "healthy",
            "unknown",
            "informational"
          ]
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error",
            "critical",
            "unknown"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "native_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "native_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "attributes": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 1024
      }
    }
  }
}
