{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runbrace:schema:normalization-result:1",
  "title": "Runbrace draft normalization result v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "conditions"
      ],
      "properties": {
        "outcome": {
          "const": "emit"
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "urn:runbrace:schema:condition-draft:1"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "reason_code"
      ],
      "properties": {
        "outcome": {
          "const": "ignore"
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "field_pointer": {
          "type": "string",
          "format": "json-pointer",
          "maxLength": 256
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "reason_code"
      ],
      "properties": {
        "outcome": {
          "const": "quarantine"
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "field_pointer": {
          "type": "string",
          "format": "json-pointer",
          "maxLength": 256
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "reason_code"
      ],
      "properties": {
        "outcome": {
          "const": "retry_later"
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "field_pointer": {
          "type": "string",
          "format": "json-pointer",
          "maxLength": 256
        }
      }
    }
  ]
}
