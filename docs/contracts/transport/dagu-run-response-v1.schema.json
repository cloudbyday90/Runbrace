{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runbrace:schema:dagu-run-response:1",
  "title": "Runbrace draft Dagu run-reference acknowledgment v1",
  "description": "Native reference shape only; expected run/DAG matching and acceptance contract are application checks.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "dagRunId",
    "dagName"
  ],
  "properties": {
    "dagRunId": {
      "type": "string",
      "minLength": 45,
      "maxLength": 45,
      "pattern": "^runbrace-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "dagName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
