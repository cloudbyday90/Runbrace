{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runbrace:schema:dagu-webhook-request:1",
  "title": "Runbrace draft Dagu webhook request profile v1",
  "description": "Restricted proposed native wrapper; installed Dagu support must be verified.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dagRunId",
    "payload"
  ],
  "properties": {
    "dagRunId": {
      "type": "string",
      "minLength": 45,
      "maxLength": 45,
      "pattern": "^runbrace-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "payload": {
      "$ref": "urn:runbrace:schema:condition:1"
    }
  }
}
