{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runbrace:observability:log-record:1",
  "title": "Offline Runbrace telemetry projection v1 (not a ledger record)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "timestamp", "resource", "operation", "outcome", "reason"],
  "dependentRequired": {"trace_id": ["span_id"], "span_id": ["trace_id"]},
  "properties": {
    "version": {"const": 1},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "maxLength": 20},
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["service.name", "service.version", "deployment.environment.name"],
      "properties": {
        "service.name": {"enum": ["runbrace-compatibility", "runbrace-forwarder"]},
        "service.version": {"type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$", "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}},
        "deployment.environment.name": {"enum": ["offline", "staging", "production"]}
      }
    },
    "operation": {"enum": ["intake", "normalize", "ledger_write", "handoff", "scan"]},
    "outcome": {"enum": ["accepted", "succeeded", "failed", "refused", "unknown"]},
    "reason": {"enum": ["none", "validation", "dependency", "capacity", "timeout", "unclassified"]},
    "request_id": {"$ref": "#/$defs/correlation"},
    "job_id": {"$ref": "#/$defs/correlation"},
    "event_id": {"$ref": "#/$defs/correlation"},
    "attempt_id": {"$ref": "#/$defs/correlation"},
    "legacy_id": {"$ref": "#/$defs/correlation"},
    "duration_ms": {"type": "number", "minimum": 0, "maximum": 86400000},
    "trace_id": {"type": "string", "minLength": 32, "maxLength": 32, "pattern": "^[0-9a-f]{32}$", "not": {"const": "00000000000000000000000000000000"}},
    "span_id": {"type": "string", "minLength": 16, "maxLength": 16, "pattern": "^[0-9a-f]{16}$", "not": {"const": "0000000000000000"}}
  },
  "$defs": {"correlation": {"type": "string", "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$", "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}}}
}
